# Make file for a loadable driver

AS=exec /bin/as
CC=exec /bin/cc
CPP=exec /lib/cpp
CFLAGS=-I.. -I../sys -I../.. -I../../sys \
	-I/usr/include/sys
AFLAGS=-gx

# Include directories
USRINC=/usr/include
SYSINC=/usr/include/sys
KERINC=/usr/src/sys/sys
DRVINC=/usr/src/sys/i8086/sys
USRSYS=/usr/sys

DRVOBJ=	objects/qq.o

qq: objects/qq.o
	rm -f $(USRSYS)/lib/qq.a
	ar rc $(USRSYS)/lib/qq.a objects/qq.o

objects/qq.o:				\
		$(KERINC)/coherent.h	$(SYSINC)/types.h \
					$(SYSINC)/machine.h $(SYSINC)/param.h \
					$(SYSINC)/fun.h \
		$(SYSINC)/con.h		\
		$(USRINC)/errno.h	\
		$(SYSINC)/sched.h	\
		$(SYSINC)/seg.h		\
		$(SYSINC)/stat.h	\
		$(SYSINC)/types.h	\
		$(SYSINC)/uproc.h	\
		qq.c
	$(CC) $(CFLAGS) -c -o $@ qq.c
